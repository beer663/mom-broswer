<?xml version="1.0" encoding="utf-8"?>
<com.phlox.tvwebbrowser.widgets.CheckableContainer xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/web_tab_width"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:nextFocusUp="@+id/ibMenu"
    android:nextFocusDown="@+id/ibHome"
    android:paddingStart="@dimen/web_tab_padding"
    android:paddingEnd="@dimen/web_tab_padding"
    android:background="@drawable/webtab_horizontal_bkg_selector">
    <ImageView
        android:id="@+id/ivFavicon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        tools:src="@drawable/ic_launcher"
        android:scaleType="fitCenter"
        android:layout_margin="5dp" />
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toEndOf="@+id/ivFavicon"
        android:layout_toStartOf="@+id/ibCloseTab"
        android:duplicateParentState="true"
        android:textColor="@color/webtab_horizontal_text_selector"
        tools:text="@string/app_name"
        android:textSize="20sp"
        android:gravity="center_vertical"
        android:layout_marginStart="3dp"
        android:lines="1"
        android:ellipsize="end"
        android:paddingStart="0dp"
        android:paddingEnd="4dp"/>
    <!-- Visible on the currently open tab only. This is deliberately a child
         click target, not the tab itself, so pressing X does not select it. -->
    <ImageButton
        android:id="@+id/ibCloseTab"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="4dp"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:background="@drawable/button_bg_selector"
        android:src="@drawable/ic_close_grey_900_24dp"
        android:contentDescription="@string/close_tab"
        android:focusable="true"
        android:clickable="true"
        android:visibility="invisible" />
</com.phlox.tvwebbrowser.widgets.CheckableContainer>